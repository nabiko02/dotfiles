#################
### AUTOSTART ###
#################

exec-once = waybar
exec-once = nm-applet --indicator
exec-once = hypridle
exec-once = hyprctl setcursor BreezeX-Light 36
exec-once = discord
exec-once = zen-browser
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = vicinae server

# Keyboards color randomizer
exec-once = python $HOME/.local/bin/razer_keyboard.py

# wallpaper
exec-once = hyprpaper
exec-once = $HOME/.config/hypr/change_wallpapers.sh
# for work
exec-once = /opt/teams-for-linux/teams-for-linux 

